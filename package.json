{
  "name": "xln",
  "version": "1.0.0-alpha.2",
  "description": "Remote control library for B&K Precision XLN series programmable DC power supplies (SCPI over TCP)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.mts",
        "default": "./dist/testing/index.mjs"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "testing"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "probe": "tsx scripts/probe.ts",
    "smoke": "tsx scripts/smoke.ts",
    "check:package": "publint --strict && attw --pack .",
    "prepublishOnly": "tsx scripts/guard-publish.ts && npm run build",
    "discover": "tsx scripts/discover.ts",
    "probe:udp": "tsx scripts/probe-udp.ts",
    "probe:udp:format": "tsx scripts/probe-udp-format.ts",
    "probe:output": "tsx scripts/probe-output-on.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinderblock/XLN.git"
  },
  "keywords": [
    "5025",
    "B&K Precision",
    "BK Precision",
    "DC Power Supply",
    "Power Supply",
    "Programmable Power Supply",
    "SCPI",
    "XLN",
    "XLN3640",
    "XLN6024",
    "XLN8018",
    "XLN10014",
    "XLN15010",
    "XLN30052",
    "XLN60026"
  ],
  "author": "Cameron Tacklind <cameron@tacklind.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cinderblock/XLN/issues"
  },
  "homepage": "https://github.com/cinderblock/XLN#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "sideEffects": false,
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
